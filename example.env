# Manual installs for checking: uv

# Required  
OPENAI_API_KEY='your_openai_api_key_here'
TAVILY_API_KEY='your_tavily_api_key_here'

# optional, only used in Module 1, Lesson 1 once
ANTHROPIC_API_KEY='your_anthropic_api_key_here'
GOOGLE_API_KEY='your_google_api_key_here'

# Optional for evaluation and tracing
LANGSMITH_API_KEY='your_langsmith_api_key_here'
# uncomment to set tracing to true when you set up your LangSmith account
# LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lca-lc-foundation
# Uncomment the following if you are on the EU instance:
#LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Modeles du cours — bascule de fournisseur en un seul endroit.
# Valeurs d'origine (OpenAI/Anthropic) conservees en commentaire.
COURSE_MODEL='google_genai:gemini-3.1-flash-lite'
COURSE_MODEL_LARGE='google_genai:gemini-2.5-flash'
COURSE_MODEL_SMALL='google_genai:gemini-3.5-flash-lite'
COURSE_MODEL_AUDIO='google_genai:gemini-2.5-flash'
COURSE_EMBEDDINGS='models/gemini-embedding-001'
